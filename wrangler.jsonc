{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "learning-js-telegram-bot",
    "main": "src/index.js",
    "compatibility_date": "2026-08-25",
    "observability": {
        "enabled": true
    },
    "triggers": {
        "crons": [
            "* * * * *"
        ]
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "learning_js_bot_db",
            "database_name": "learning-js-bot-db",
            "database_id": "d4d0102a-b2c6-42b4-99bb-6ecc2bcd1df0"
        }
    ]
}